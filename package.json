{
  "name": "fiverunner",
  "version": "0.5.1",
  "description": "Run FiveM resources (Lua + NUI) in your browser and in CI. No GTA V, no server, no restarts.",
  "keywords": [
    "fivem",
    "cfx",
    "gta5",
    "lua",
    "nui",
    "emulator",
    "testing",
    "ci"
  ],
  "homepage": "https://github.com/DariusHQ/fiverunner#readme",
  "bugs": "https://github.com/DariusHQ/fiverunner/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DariusHQ/fiverunner.git"
  },
  "license": "MIT",
  "author": "DariusHQ",
  "type": "module",
  "bin": {
    "fiverunner": "dist/fiverunner.js"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build && vite build -c vite.ui.config.ts && vite build -c vite.sw.config.ts",
    "prepack": "npm run build",
    "build:wasm": "node scripts/build-wasm.ts",
    "build:natives": "node scripts/generate-natives.ts",
    "build:mime": "node scripts/generate-mime.ts",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@citizenfx/client": "2.0.37175-1",
    "@citizenfx/server": "2.0.37175-1",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "@types/node": "22.18.13",
    "mime": "2.4.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.2"
  }
}
